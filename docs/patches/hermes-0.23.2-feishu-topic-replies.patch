+@pytest.mark.asyncio
+@pytest.mark.parametrize("command", ["/approve", "/deny", "/steer note"])
+async def test_consumed_busy_command_persists_feishu_dedup(monkeypatch, command):
+    from gateway.config import PlatformConfig
+    from gateway.platforms.event import MessageEvent, MessageType
+    from plugins.platforms.feishu.adapter import FeishuAdapter
+    from tools import approval, slash_confirm
+
+    rig = await _start_a(monkeypatch, "queue")
+    slash_confirm.clear(rig.key)
+    transport = FeishuAdapter(PlatformConfig())
+    applied = []
+    if command.startswith("/steer"):
+        agent = rig.runner._session_state(rig.key).turn.agent
+        agent.steer = lambda text: applied.append(text) or True
+    else:
+        monkeypatch.setattr(rig.runner, "_blocking_approval_or_stale", lambda *_a, **_kw: (rig.key, None, ["req"]))
+        monkeypatch.setattr(approval, "resolve_gateway_approval", lambda *_a, **_kw: applied.append(command) or 1)
+
+    try:
+        assert not await transport._is_duplicate("om_command", pending_admission=True)
+        event = MessageEvent(text=command, message_type=MessageType.COMMAND, source=rig.source, message_id="om_command")
+        event.add_commit_callback(lambda: transport._commit_seen_message("om_command"))
+        await rig.adapter.handle_message(event)
+        assert len(applied) == 1 and transport._dedup_flush_task is not None, rig.sent
+        await transport._dedup_flush_task
+        restarted = FeishuAdapter(PlatformConfig())
+        assert await restarted._is_duplicate("om_command", pending_admission=True)
+        assert "om_command" not in _rows(rig)
+    finally:
+        rig.finish.set()
+
