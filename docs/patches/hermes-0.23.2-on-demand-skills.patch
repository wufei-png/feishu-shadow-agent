diff --git a/tests/agent/test_bot_profile_prompt_isolation.py b/tests/agent/test_bot_profile_prompt_isolation.py
index ffcbb315..a941bad8 100644
--- a/tests/agent/test_bot_profile_prompt_isolation.py
+++ b/tests/agent/test_bot_profile_prompt_isolation.py
@@ -67,1 +67,46 @@ def test_skills_prompt_scoped_to_override_not_ambient_home(tmp_path, monkeypatch
+def test_skills_guidance_is_profile_scoped_and_cached_by_setting(tmp_path, monkeypatch):
+    from agent import prompt_builder
+
+    default_home = tmp_path / "default"
+    coworker_home = tmp_path / "profiles" / "coworker"
+    for home in (default_home, coworker_home):
+        skill = home / "skills" / "general" / "example"
+        skill.mkdir(parents=True)
+        (skill / "SKILL.md").write_text(
+            "---\nname: example\ndescription: Example workflow\n---\nbody\n",
+            encoding="utf-8",
+        )
+    monkeypatch.setenv("HERMES_HOME", str(default_home))
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM", "feishu")
+    (coworker_home / "config.yaml").write_text(
+        "skills:\n  prompt_guidance:\n    feishu: on_demand\n", encoding="utf-8"
+    )
+    prompt_builder.clear_skills_system_prompt_cache(clear_snapshot=False)
+
+    default_prompt = prompt_builder.build_skills_system_prompt(
+        skills_dir_override=default_home / "skills"
+    )
+    coworker_prompt = prompt_builder.build_skills_system_prompt(
+        skills_dir_override=coworker_home / "skills"
+    )
+    assert "you MUST load" in default_prompt
+    assert "you MUST load" not in coworker_prompt
+    assert _skills_body(default_prompt) == _skills_body(coworker_prompt)
+
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM", "cron")
+    cron_prompt = prompt_builder.build_skills_system_prompt(
+        skills_dir_override=coworker_home / "skills"
+    )
+    assert "you MUST load" in cron_prompt
+
+    monkeypatch.setenv("HERMES_SESSION_PLATFORM", "feishu")
+    (coworker_home / "config.yaml").write_text(
+        "skills:\n  prompt_guidance:\n    feishu: default\n", encoding="utf-8"
+    )
+    rebuilt = prompt_builder.build_skills_system_prompt(
+        skills_dir_override=coworker_home / "skills"
+    )
+    assert "you MUST load" in rebuilt
+
+
